# =============================================================================
# Plantilla de secretos para Streamlit Cloud.
# Pegá estos valores en Settings → Secrets. Sin claves, la app usa los
# proveedores gratuitos (Google STT + gTTS + keywords).
# =============================================================================

# GROQ_API_KEY = ""
# ASSEMBLYAI_API_KEY = ""
# ELEVENLABS_API_KEY = ""
# OPENAI_API_KEY = ""
# DID_API_KEY = ""

# --- Firebase (banco de preguntas, opcional) ---
# Opción A: pegar el contenido JSON de la cuenta de servicio como string.
# FIREBASE_SERVICE_ACCOUNT = """{"type":"service_account","project_id":"...","private_key":"..."}"""
# Opción B: ruta a un archivo en el filesystem del despliegue.
# FIREBASE_SERVICE_ACCOUNT_PATH = "secrets/firebase-service-account.json"
