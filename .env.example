# =============================================================================
# Plantilla de secretos. Copiá a `.env` (local) o `.streamlit/secrets.toml`
# (Streamlit Cloud). Ninguna clave es obligatoria: sin claves, la app usa los
# proveedores GRATUITOS (Google STT + gTTS + evaluación por palabras clave).
# =============================================================================

# --- Evaluación con LLM (Groq) ---
GROQ_API_KEY=

# --- Reconocimiento de voz (alternativas pagas) ---
ASSEMBLYAI_API_KEY=

# --- Síntesis de voz (alternativas pagas) ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Avatar (D-ID, opcional) ---
DID_API_KEY=

# --- Firebase (banco de preguntas, opcional) ---
# Opción A: pegar el contenido JSON de la cuenta de servicio (una línea).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# Opción B: ruta a un archivo JSON local (NO versionado).
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

